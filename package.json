{
  "name": "agentic-geo",
  "version": "0.1.0",
  "description": "Portable longitude primitives with no runtime dependencies or effects.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huijoohwee/agentic-geo.git"
  },
  "scripts": {
    "setup": "agentic-os setup",
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land",
    "release:common": "agentic-os release-common",
    "check": "node --test test/*.test.mjs && npm --prefix node_modules/agentic-os run evals",
    "test": "node --test test/*.test.mjs",
    "successor": "agentic-os successor",
    "sync:canonical": "agentic-os canonical-sync"
  },
  "devDependencies": {
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/c2c2dfd4660d66ed3abf1fb73d2448bc7ea19005"
  },
  "exports": {
    "./core": {
      "types": "./src/core.d.mts",
      "import": "./src/core.mjs"
    },
    "./testing/longitude-cases": "./test/longitude-cases.mjs"
  },
  "files": [
    "src",
    "test/longitude-cases.mjs",
    "LICENSE",
    "README.md",
    "docs/source-contract.md"
  ],
  "sideEffects": false
}
